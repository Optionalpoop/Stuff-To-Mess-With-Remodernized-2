{
  "multipart": [
    {
      "apply": {
        "model": "stmwr:block/applevine_post"
      }
    },
    {
      "when": {
        "north": true
      },
      "apply": {
        "model": "stmwr:block/applevine_side"
      }
    },
    {
      "when": {
        "east": true
      },
      "apply": {
        "model": "stmwr:block/applevine_side",
        "y": 90
      }
    },
    {
      "when": {
        "south": true
      },
      "apply": {
        "model": "stmwr:block/applevine_side_alt"
      }
    },
    {
      "when": {
        "west": true
      },
      "apply": {
        "model": "stmwr:block/applevine_side_alt",
        "y": 90
      }
    },
    {
      "when": {
        "north": false
      },
      "apply": {
        "model": "stmwr:block/applevine_noside"
      }
    },
    {
      "when": {
        "east": false
      },
      "apply": {
        "model": "stmwr:block/applevine_noside_alt"
      }
    },
    {
      "when": {
        "south": false
      },
      "apply": {
        "model": "stmwr:block/applevine_noside_alt",
        "y": 90
      }
    },
    {
      "when": {
        "west": false
      },
      "apply": {
        "model": "stmwr:block/applevine_noside",
        "y": 270
      }
    }
  ]
}